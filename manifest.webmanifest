{
    "name": "Tot Play",
    "short_name": "TotPlay",
    "description": "Fun touch games for toddlers: colors, ABC match, numbers, shapes, letter tracing, silhouette matching, pop counting, peek-a-boo.",
    "start_url": "./index.html",
    "scope": "./",
    "display": "fullscreen",
    "orientation": "any",
    "background_color": "#fef6e4",
    "theme_color": "#fef6e4",
    "icons": [
        { "src": "icons/favicon.png", "sizes": "48x48", "type": "image/png", "purpose": "any" },
        { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
        { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
        { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
    ]
}
